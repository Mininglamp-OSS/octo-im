# Native PR preview build. Match the inspected fix1 image's Go/runtime versions.
FROM node:20-bookworm AS frontend
RUN corepack enable && corepack prepare yarn@1.22.22 --activate
WORKDIR /frontend
COPY demo/chatdemo ./chatdemo
COPY web ./web
RUN cd chatdemo && yarn install --frozen-lockfile --non-interactive && yarn build
RUN cd web && yarn install --frozen-lockfile --non-interactive && yarn build

FROM golang:1.23.0 AS build
ENV GOTOOLCHAIN=local CGO_ENABLED=0 GOOS=linux
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
# Copy compiled assets only: do not embed frontend node_modules into the binary.
COPY --from=frontend /frontend/chatdemo/dist ./demo/chatdemo/dist
COPY --from=frontend /frontend/web/dist ./web/dist
ARG SOURCE_REVISION
ARG SOURCE_DATE
ARG SOURCE_VERSION
RUN test -n "${SOURCE_REVISION}" && test -n "${SOURCE_DATE}" && test -n "${SOURCE_VERSION}" && \
    go version && \
    go build -ldflags="-w -extldflags '-static' -X main.Commit=${SOURCE_REVISION} -X main.CommitDate=${SOURCE_DATE} -X main.Version=${SOURCE_VERSION} -X main.TreeState=clean" \
      -installsuffix cgo -o /out/app ./main.go && \
    go version -m /out/app > /out/buildinfo.txt

FROM alpine:3.23.4
RUN apk add --no-cache ca-certificates tzdata && \
    cp /usr/share/zoneinfo/Asia/Shanghai /etc/localtime && \
    echo "Asia/Shanghai" > /etc/timezone
WORKDIR /home
COPY --from=build /out/app /home/app
COPY --from=build /out/buildinfo.txt /home/buildinfo.txt
COPY config/wk.yaml /root/wukongim/wk.yaml
ENTRYPOINT ["/home/app","--config=/root/wukongim/wk.yaml","--ignoreMissingConfig=true"]
